{
  "name": "chat2shell",
  "version": "0.1.0",
  "description": "A private MCP control plane for isolated shell and sandbox access from ChatGPT.",
  "homepage": "https://github.com/nbsp1221/chat2shell#readme",
  "bugs": "https://github.com/nbsp1221/chat2shell/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nbsp1221/chat2shell.git"
  },
  "bin": {
    "chat2shell": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "ROADMAP.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "cli": "node dist/cli.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint . && eslint .",
    "release": "release-it",
    "start": "node dist/cli.mjs serve",
    "test": "vitest run --project unit --project integration",
    "test:coverage": "vitest run --coverage --project unit --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:integration": "vitest run --project integration",
    "test:unit": "vitest run --project unit",
    "test:watch": "vitest --project unit --project integration",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "cac": "7.0.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@retn0/eslint-config": "2.1.0",
    "@retn0/eslint-config-oxlint": "0.1.2",
    "@retn0/oxfmt-config": "0.2.0",
    "@retn0/oxlint-config": "2.2.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.7.0",
    "oxfmt": "0.59.0",
    "oxlint": "1.73.0",
    "oxlint-tsgolint": "0.25.0",
    "release-it": "21.0.2",
    "tsdown": "0.22.14",
    "typescript": "^5.9.0",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.23.0"
}
